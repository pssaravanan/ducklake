# name: test/sql/branch/branch_concurrent.test
# description: two connections committing to the same branch - the second commit fails
# group: [branch]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/branch_concurrent_files', METADATA_CATALOG 'ducklake_meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
USE ducklake

statement ok
CREATE TABLE t(i INTEGER)

statement ok
INSERT INTO t SELECT range FROM range(10)

statement ok
CREATE BRANCH b1

statement ok con1
USE ducklake

statement ok con2
USE ducklake

statement ok con1
SET BRANCH b1

statement ok con2
SET BRANCH b1

statement ok con1
BEGIN

statement ok con2
BEGIN

statement ok con1
INSERT INTO t VALUES (1)

statement ok con2
INSERT INTO t VALUES (2)

statement ok con1
COMMIT

statement error con2
COMMIT
----
was changed or dropped by another transaction

query II con2
SELECT COUNT(*), SUM(i) FROM t
----
11	46

# main never saw any of it
statement ok con2
SET BRANCH main

query II con2
SELECT COUNT(*), SUM(i) FROM t
----
10	45
